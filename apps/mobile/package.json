{
  "name": "@churchkit/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "ChurchKit mobile app \u2014 React Native / Expo.",
  "main": "index.js",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
